{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://148.251.171.147:5000/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "http://148.251.171.147:5000/webhooks/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
