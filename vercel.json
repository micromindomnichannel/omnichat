{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://omnichat-production-65a3.up.railway.app/api/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "https://omnichat-production-65a3.up.railway.app/webhooks/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
