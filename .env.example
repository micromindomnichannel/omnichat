# ORBIT Omnichannel PostgreSQL Database Credentials Example
# NOTE: never commit real passwords. Fill these locally in .env (gitignored).
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=omnichannel

# Full PostgreSQL Connection URI
DATABASE_URL=postgresql://postgres:change-me@your-postgres-host:5432/omnichannel

# API Server Port
PORT=5000

# Comma-separated allowed browser origins (CORS). Non-browser callers
# (Meta webhooks, curl) have no Origin and are always allowed.
CORS_ORIGIN=http://localhost:3000

# MicroMind (AI/execution layer) — backend only, never expose to frontend
MICROMIND_BASE_URL=https://core.aimicromind.com/api/v1
MICROMIND_API_KEY=
MICROMIND_MESSENGER_FLOW_ID=f4a7c66d-dc4c-4f0b-b12d-4b6ca91fe0c8
# Dedicated analyst flow for reports + knowledge answers (optional).
# Falls back to MICROMIND_MESSENGER_FLOW_ID when unset.
MICROMIND_ANALYST_FLOW_ID=

# Credential vault key: 64 hex chars (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# REQUIRED in production; dev falls back to a local-only key with a warning.
CRED_KEY=

# Meta Graph API version for sends (Messenger + Instagram)
META_GRAPH_VERSION=v19.0

# Meta App Secret: enables X-Hub-Signature-256 verification on
# /webhooks/{messenger,instagram,whatsapp}. Set before production.
META_APP_SECRET=

# Frontend API base (Vite). Set in frontend .env as VITE_API_URL=http://localhost:5000/api
# When developing, you can also rely on the vite proxy (see vite.config.ts).
VITE_API_URL=http://localhost:5000/api
