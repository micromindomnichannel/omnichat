# ORBIT Omnichannel PostgreSQL Database Credentials Example
DB_HOST=148.251.171.147
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=omnichannel

# Full PostgreSQL Connection URI
DATABASE_URL=postgresql://postgres:admin@148.251.171.147:5432/omnichannel

# API Server Port
PORT=5000

# MicroMind (AI/execution layer) — backend only, never expose to frontend
MICROMIND_BASE_URL=https://core.aimicromind.com/api/v1
MICROMIND_API_KEY=
MICROMIND_MESSENGER_FLOW_ID=f4a7c66d-dc4c-4f0b-b12d-4b6ca91fe0c8

# Credential vault key: 64 hex chars (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# REQUIRED in production; dev falls back to a local-only key with a warning.
CRED_KEY=

# Meta Graph API version for sends (Messenger + Instagram)
META_GRAPH_VERSION=v19.0

# Frontend API base (Vite). Set in frontend .env as VITE_API_URL=http://localhost:5000/api
