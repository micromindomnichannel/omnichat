# ORBIT Omnichannel PostgreSQL Database Credentials Example
# NOTE: never commit real passwords. Fill these locally in .env (gitignored).
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=omnichannel

# Full PostgreSQL Connection URI
DATABASE_URL=postgresql://postgres:change-me@your-postgres-host:5432/omnichannel

# API Server Port
PORT=5000

# Comma-separated allowed browser origins (CORS). Non-browser callers
# (Meta webhooks, curl) have no Origin and are always allowed.
CORS_ORIGIN=http://localhost:3000

# MicroMind (AI/execution layer) — backend only, never expose to frontend
MICROMIND_BASE_URL=https://core.aimicromind.com/api/v1
MICROMIND_API_KEY=
MICROMIND_MESSENGER_FLOW_ID=f4a7c66d-dc4c-4f0b-b12d-4b6ca91fe0c8
# Shared analyst flow (ONE flow serves all tenants: reports + knowledge answers).
# Set to the analyst flow id; per-workspace override lives in workspace_settings
# (analyst_flow_id + vaulted key) and wins when present. Falls back to
# MICROMIND_MESSENGER_FLOW_ID when unset.
MICROMIND_ANALYST_FLOW_ID=
# Shared analyst flow key. Mint once via POST /apikey, link to the analyst flow
# (flow's API protection setting), store the FRESH key here — never reuse a key
# that appeared in chat/logs. Empty = open analyst flow (will 401 if enforced).
MICROMIND_ANALYST_API_KEY=
# Provisioner identity for zero-touch tenant provisioning (Option B):
# ops-account login used ONLY for management calls (folders/flows/keys).
# Prediction calls always use per-tenant flow keys. Auto re-logs-in on 401;
# without these, management falls back to MICROMIND_API_KEY.
MICROMIND_PROVISIONER_EMAIL=
MICROMIND_PROVISIONER_PASSWORD=

# Credential vault key: 64 hex chars (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# REQUIRED in production; dev falls back to a local-only key with a warning.
CRED_KEY=

# Meta Graph API version for sends (Messenger + Instagram)
META_GRAPH_VERSION=v19.0

# Session cookies: Lax for same-site dev. Cross-site production
# (Vercel frontend + VPS API over HTTPS) needs SameSite=None + Secure.
# COOKIE_SAMESITE=None
# COOKIE_SECURE=1

# Meta App Secret: enables X-Hub-Signature-256 verification on
# /webhooks/{messenger,instagram,whatsapp}. Set before production.
META_APP_SECRET=

# Frontend API base (Vite). Set in frontend .env as VITE_API_URL=http://localhost:5000/api
# When developing, you can also rely on the vite proxy (see vite.config.ts).
VITE_API_URL=http://localhost:5000/api
