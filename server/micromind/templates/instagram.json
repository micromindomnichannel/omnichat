          },
          {
            "label": "Messages History",
            "name": "messageHistory",
            "description": "Add messages after System Message. This is useful when you want to provide few shot examples",
            "type": "tabs",
            "tabIdentifier": "selectedMessagesTab",
            "additionalParams": true,
            "default": "messageHistoryCode",
            "tabs": [
              {
                "label": "Add Messages (Code)",
                "name": "messageHistoryCode",
                "type": "code",
                "hideCodeExecute": true,
                "codeExample": "const { AIMessage, HumanMessage, ToolMessage } = require('@langchain/core/messages');\n\nreturn [\n    new HumanMessage(\"What is 333382 🦜 1932?\"),\n    new AIMessage({\n        content: \"\",\n        tool_calls: [\n        {\n            id: \"12345\",\n            name: \"calulator\",\n            args: {\n                number1: 333382,\n                number2: 1932,\n                operation: \"divide\",\n            },\n        },\n        ],\n    }),\n    new ToolMessage({\n        tool_call_id: \"12345\",\n        content: \"The answer is 172.558.\",\n    }),\n    new AIMessage(\"The answer is 172.558.\"),\n]",
                "optional": true,
                "additionalParams": true
              }
            ],
            "id": "chatPromptTemplate_0-input-messageHistory-tabs"
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "systemMessagePrompt": "You are a helpful AI assistant responding to Instagram Direct Messages.\n\nContext:\n- Instagram Sender IGSID: {senderIgsid}\n- User Message: {input}\n\nReply naturally and helpfully to the user's message.\n\nSTRICT RULE:\nYou MUST use the Instagram Messenger \"Send Text Message\" tool to send your final response.\n\nWhen calling the tool:\n- recipientPsid: {senderIgsid}\n- messageText: Your final reply to the user.\n\nDo not only return text.\nAlways send the final response using the Instagram Messenger tool.",
          "humanMessagePrompt": "{input}",
          "promptValues": "{\"senderIgsid\":\"{{instagramTrigger_0.data.instance.senderIgsid}}\",\"input\":\"{{instagramTrigger_0.data.instance.text}}\\n\"}",
          "messageHistory": "messageHistoryCode"
        },
